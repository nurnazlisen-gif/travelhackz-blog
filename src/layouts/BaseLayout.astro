---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '@vercel/analytics/astro';
import { getImage } from 'astro:assets';
import defaultOgImageSrc from '../images/blog/istanbul-skyline-bosphorus-aerial-view.jpg';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
}

const { title, description, image, type = 'website' } = Astro.props;

// Social platforms (WhatsApp, iMessage, older Facebook/LinkedIn crawlers) don't
// reliably render WebP previews, so the share image is forced to JPEG at the
// standard 1200x630 (1.91:1) og:image ratio regardless of the source image's shape.
let resolvedImagePath: string;
if (image && typeof image !== 'string') {
  const optimized = await getImage({ src: image, width: 1200, height: 630, format: 'jpg' });
  resolvedImagePath = optimized.src;
} else if (image) {
  resolvedImagePath = image;
} else {
  const optimizedDefault = await getImage({
    src: defaultOgImageSrc,
    width: 1200,
    height: 630,
    format: 'jpg',
  });
  resolvedImagePath = optimizedDefault.src;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(resolvedImagePath, Astro.site);
const siteName = 'TravelHackz';
const suffixed = `${title} | ${siteName}`;
// Only brand-suffix short titles — appending " | TravelHackz" to an
// already-long post title just pushes it past Google's ~60-char SERP cutoff.
const fullTitle = title.includes(siteName) ? title : suffixed.length <= 60 ? suffixed : title;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: new URL('/', Astro.site).toString(),
  logo: new URL('/icon-512.png', Astro.site).toString(),
  sameAs: ['https://www.instagram.com/travelhackz.online/'],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL('/', Astro.site).toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="Y-268kslzK8hnoyeGu5WY1Pil-h_NA0VikrE6YVPCBY" />
    <meta name="msvalidate.01" content="C32177509B44574B46B47B67916D3E0B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#c4602a" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="TravelHackz RSS Feed" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
