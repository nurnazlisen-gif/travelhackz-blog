---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '@vercel/analytics/astro';
import { getImage } from 'astro:assets';
import defaultOgImageSrc from '../images/blog/istanbul-skyline-bosphorus-aerial-view.jpg';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
}

const { title, description, image, type = 'website' } = Astro.props;

let resolvedImagePath: string;
if (image && typeof image !== 'string') {
  const optimized = await getImage({ src: image, width: 1200 });
  resolvedImagePath = optimized.src;
} else if (image) {
  resolvedImagePath = image;
} else {
  const optimizedDefault = await getImage({ src: defaultOgImageSrc, width: 1200 });
  resolvedImagePath = optimizedDefault.src;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(resolvedImagePath, Astro.site);
const siteName = 'TravelHackz';
const suffixed = `${title} | ${siteName}`;
// Only brand-suffix short titles — appending " | TravelHackz" to an
// already-long post title just pushes it past Google's ~60-char SERP cutoff.
const fullTitle = title.includes(siteName) ? title : suffixed.length <= 60 ? suffixed : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#c4602a" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="TravelHackz RSS Feed" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
