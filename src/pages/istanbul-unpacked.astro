---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';

const posts = (await getCollection('blog', ({ data }) => data.series === 'Istanbul Unpacked' && !data.draft)).sort(
  (a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0)
);
---

<BaseLayout
  title="Istanbul Unpacked — The Full 8-Episode Series"
  description="Every episode of the Istanbul Unpacked podcast, written out in full: arrival to last day, budget to itineraries."
>
  <section class="hub-hero photo-cover">
    <img
      src="https://commons.wikimedia.org/wiki/Special:FilePath/Historical_peninsula_and_modern_skyline_of_Istanbul.jpg?width=1600"
      alt="Wide aerial view of Istanbul's historic peninsula with domed mosques beside the Bosphorus and the modern skyline beyond"
    />
    <div class="container hub-hero-inner">
      <p class="eyebrow" style="color:#fff">Podcast Series</p>
      <h1>Istanbul Unpacked</h1>
      <p class="hub-desc">
        The full written guides behind our 8-episode, 10-minutes-per-episode podcast for
        travelers. From your first 24 hours to the right order for Sultanahmet, the split
        between Istanbul's two continents, and how to win your last day — everything you need
        to actually live the city, not just visit it.
      </p>
    </div>
    <p class="hero-credit">Photo by Hunanuk / Wikimedia Commons (CC0)</p>
  </section>

  <section class="container listen-section">
    <div class="listen-card">
      <div>
        <p class="eyebrow">Listen</p>
        <a class="btn btn-outline" href="https://podcasts.apple.com" target="_blank" rel="noopener">
          Apple Podcasts
        </a>
      </div>
      <SpotifyEmbed embedUrl="https://open.spotify.com/embed/show/0340QAelnsERPiwoQESar3" />
    </div>
  </section>

  <section class="container episode-list">
    <ol>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="episode-row">
            <span class="episode-number">{String(post.data.episode).padStart(2, '0')}</span>
            <span class="episode-info">
              <strong>{post.data.title}</strong>
              <span>{post.data.description}</span>
            </span>
            <span class="episode-arrow">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hub-hero {
    color: #fff;
    padding: 4rem 0;
    min-height: 320px;
    display: flex;
    align-items: center;
  }
  .hub-hero-inner {
    position: relative;
    z-index: 1;
  }
  .hero-credit {
    position: absolute;
    bottom: 0.6rem;
    right: 1.2rem;
    font-size: 0.68rem;
    color: #fff;
    opacity: 0.7;
    margin: 0;
    z-index: 1;
  }
  .hub-desc {
    max-width: 65ch;
    font-size: 1.1rem;
    opacity: 0.95;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }
  .listen-section {
    padding: 2rem 0 1rem;
  }
  .listen-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.6rem 1.8rem;
  }
  @media (max-width: 640px) {
    .listen-card {
      grid-template-columns: 1fr;
    }
  }
  .episode-list {
    padding: 3rem 0 4rem;
  }
  .episode-list ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .episode-row {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem;
    color: var(--color-text);
  }
  .episode-row:hover {
    text-decoration: none;
    border-color: var(--color-primary);
  }
  .episode-number {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-primary);
    min-width: 2.4ch;
  }
  .episode-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .episode-info span {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .episode-arrow {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
