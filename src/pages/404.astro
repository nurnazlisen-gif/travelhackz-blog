---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="This page doesn't exist — but the rest of TravelHackz does."
>
  <section class="container not-found">
    <p class="eyebrow">404</p>
    <h1>This page took a wrong turn.</h1>
    <p class="lead">
      The page you're looking for doesn't exist, moved, or the link was mistyped. Here's where
      you probably meant to go:
    </p>
    <div class="actions">
      <a class="btn" href="/">Back to Home</a>
      <a class="btn btn-outline" href="/blog">Browse All Posts</a>
    </div>
    <div class="quick-links">
      <a href="/istanbul-unpacked">Istanbul Unpacked Series</a>
      <a href="/podcast">Podcast</a>
      <a href="/gallery">Gallery</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 5rem 0 6rem;
    max-width: 640px;
    text-align: left;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin: 0.4rem 0 1rem;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }
  .actions {
    display: flex;
    gap: 1rem;
    margin: 1.75rem 0 2.5rem;
    flex-wrap: wrap;
  }
  .quick-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .quick-links a {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-secondary);
  }
</style>
