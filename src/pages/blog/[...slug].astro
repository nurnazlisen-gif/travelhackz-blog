---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const seriesPosts = posts
    .filter((p) => p.data.series && typeof p.data.episode === 'number')
    .sort((a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0));

  return posts.map((post) => {
    const idx = seriesPosts.findIndex((p) => p.id === post.id);
    const prevPost = idx > 0 ? seriesPosts[idx - 1] : null;
    const nextPost = idx >= 0 && idx < seriesPosts.length - 1 ? seriesPosts[idx + 1] : null;
    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post} prevPost={prevPost} nextPost={nextPost}>
  <Content />
</BlogPostLayout>
