---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.episode ?? 99) - (b.data.episode ?? 99)
);
---

<BaseLayout
  title="Blog — All Posts"
  description="Browse every travel guide on TravelHackz: routes, timing and practical tips, city by city."
>
  <section class="container page-header">
    <p class="eyebrow">Blog</p>
    <h1>All Posts</h1>
    <p class="page-desc">Travel guides planned city by city, hour by hour.</p>
  </section>

  <section class="container">
    <div class="grid">
      {posts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          heroGradient={post.data.heroGradient}
          heroLabel={post.data.heroLabel}
          episode={post.data.episode}
          destination={post.data.destination}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: 3rem 0 1rem;
  }
  .page-desc {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 60ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem 0 4rem;
  }
</style>
