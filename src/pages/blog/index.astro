---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — All Posts"
  description="Browse every travel guide on TravelHackz: routes, timing and practical tips, city by city."
>
  <section class="container page-header">
    <p class="eyebrow">Blog</p>
    <h1>All Posts</h1>
    <p class="page-desc">Travel guides planned city by city, hour by hour.</p>
    <div class="search-box">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        id="blog-search"
        placeholder="Search posts (e.g. Cappadocia, budget, ferry)..."
        aria-label="Search posts"
      />
    </div>
  </section>

  <section class="container">
    <p id="no-results" hidden>No posts match your search.</p>
    <div class="grid" id="post-grid">
      {posts.map((post) => (
        <div
          class="grid-item"
          data-search={`${post.data.title} ${post.data.description} ${post.data.destination}`.toLowerCase()}
        >
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            heroImage={post.data.heroImage}
            heroImageAlt={post.data.heroImageAlt}
            heroLabel={post.data.heroLabel}
            episode={post.data.episode}
            destination={post.data.destination}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('blog-search') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.grid-item'));
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visibleCount = 0;

    for (const item of items) {
      const matches = !query || (item.dataset.search ?? '').includes(query);
      item.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    }

    if (noResults) noResults.hidden = visibleCount !== 0;
  });
</script>

<style>
  .page-header {
    padding: 3rem 0 1rem;
  }
  .page-desc {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 60ch;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.7rem 1.1rem;
    max-width: 420px;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }
  .search-box input {
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--color-text);
    width: 100%;
  }
  #no-results {
    color: var(--color-text-muted);
    padding: 1rem 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem 0 4rem;
  }
</style>
