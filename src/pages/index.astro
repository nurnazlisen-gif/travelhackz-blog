---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import KeepsmybagBanner from '../components/KeepsmybagBanner.astro';

const istanbulPosts = (
  await getCollection('blog', ({ data }) => data.series === 'Istanbul Unpacked' && !data.draft)
).sort((a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0));

const turkeyPosts = (
  await getCollection('blog', ({ data }) => !data.series && !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="TravelHackz — No-Fluff Travel Guides"
  description="Travel guides built on real routes, real timing and real prices, across Istanbul and the rest of Turkey."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Welcome to TravelHackz</p>
      <h1>No-fluff travel guides, timed to the hour.</h1>
      <p class="hero-desc">
        Real routes, real timing and real prices instead of generic advice — covering{' '}
        <strong>Istanbul</strong> and the rest of <strong>Turkey</strong>.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/istanbul-unpacked">Istanbul Unpacked Series</a>
        <a class="btn btn-outline" href="/blog">All Posts</a>
      </div>
    </div>
  </section>

  <section class="container featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Podcast Series</p>
        <h2>Istanbul Unpacked</h2>
      </div>
      <a href="/istanbul-unpacked">See the full series →</a>
    </div>
    <div class="grid">
      {istanbulPosts.slice(0, 3).map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          heroLabel={post.data.heroLabel}
          episode={post.data.episode}
          destination={post.data.destination}
        />
      ))}
    </div>
  </section>

  <section class="container banner-section">
    <KeepsmybagBanner />
  </section>

  <section class="container featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">More Destinations</p>
        <h2>Beyond Istanbul</h2>
      </div>
      <a href="/blog">See all posts →</a>
    </div>
    <div class="grid">
      {turkeyPosts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          heroImage={post.data.heroImage}
          heroImageAlt={post.data.heroImageAlt}
          heroLabel={post.data.heroLabel}
          episode={post.data.episode}
          destination={post.data.destination}
        />
      ))}
    </div>
  </section>

  <section class="container podcast-section">
    <div class="podcast-card">
      <div class="podcast-copy">
        <p class="eyebrow">Podcast</p>
        <h2>Same guides, in your ears.</h2>
        <p>Every episode runs 10 minutes. Listen on the road, then come back here for the full detail.</p>
        <a class="btn btn-outline" href="https://podcasts.apple.com" target="_blank" rel="noopener">
          Apple Podcasts
        </a>
      </div>
      <div class="podcast-player">
        <SpotifyEmbed embedUrl="https://open.spotify.com/embed/show/0340QAelnsERPiwoQESar3" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    max-width: 760px;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0.4rem 0 1rem;
  }
  .hero-desc {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 62ch;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .featured {
    padding: 3rem 0 1rem;
  }
  .banner-section {
    padding: 1rem 0;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-heading h2 {
    margin: 0.2rem 0 0;
  }
  .section-heading a {
    font-weight: 700;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .podcast-section {
    padding: 2rem 0 4rem;
  }
  .podcast-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2.2rem;
  }
  .podcast-copy p:not(.eyebrow) {
    color: var(--color-text-muted);
  }
  .podcast-copy .btn-outline {
    margin-top: 0.5rem;
  }
  @media (max-width: 720px) {
    .podcast-card {
      grid-template-columns: 1fr;
    }
  }
</style>
