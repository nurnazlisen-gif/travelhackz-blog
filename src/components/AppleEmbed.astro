---
interface Props {
  embedUrl?: string;
  title?: string;
}
const { embedUrl, title = 'Istanbul Unpacked Podcast' } = Astro.props;
---

{embedUrl ? (
  <div class="apple-embed">
    <iframe
      title={title}
      src={embedUrl}
      height="175"
      width="100%"
      frameborder="0"
      allow="autoplay *; encrypted-media *; clipboard-write"
      sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
      loading="lazy"
    ></iframe>
  </div>
) : (
  <div class="apple-placeholder">
    <span class="apple-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26">
        <circle cx="12" cy="12" r="12" fill="#9933CC" />
        <path
          fill="#fff"
          d="M12 5.5a4.2 4.2 0 0 0-4.2 4.2c0 .8.2 1.5.6 2.1-.9.6-1.5 1.7-1.5 2.9 0 1.9 1.6 3.5 3.5 3.5.5 0 1-.1 1.4-.3v-4.6a1.8 1.8 0 1 1 3.6 0v4.6c.4.2.9.3 1.4.3 1.9 0 3.5-1.6 3.5-3.5 0-1.2-.6-2.3-1.5-2.9.4-.6.6-1.3.6-2.1A4.2 4.2 0 0 0 12 5.5Z"
        />
      </svg>
    </span>
    <div>
      <p class="apple-placeholder-title">Apple Podcasts player goes here</p>
      <p class="apple-placeholder-desc">Drop in your show's embed link and it'll show up as a player right in this spot.</p>
    </div>
  </div>
)}

<style>
  .apple-embed {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .apple-embed iframe {
    display: block;
  }
  .apple-placeholder {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: var(--color-bg-alt);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem;
  }
  .apple-mark {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .apple-placeholder-title {
    margin: 0 0 0.3rem;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .apple-placeholder-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
