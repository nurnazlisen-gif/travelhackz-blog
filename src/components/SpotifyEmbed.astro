---
interface Props {
  embedUrl?: string;
  title?: string;
}
const { embedUrl, title = 'Istanbul Unpacked Podcast' } = Astro.props;
---

{embedUrl ? (
  <div class="spotify-embed">
    <iframe
      title={title}
      src={embedUrl}
      width="100%"
      height="152"
      frameborder="0"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
    ></iframe>
  </div>
) : (
  <div class="spotify-placeholder">
    <svg class="spotify-mark" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#1DB954" />
      <path
        fill="#fff"
        d="M17.2 16.4c-.2.3-.6.4-.9.2-2.5-1.5-5.6-1.9-9.3-1-.4.1-.7-.1-.8-.5-.1-.4.1-.7.5-.8 4-.9 7.5-.5 10.3 1.2.3.2.4.6.2.9zm1.2-2.7c-.3.4-.7.5-1.1.3-2.9-1.8-7.3-2.3-10.7-1.2-.4.1-.9-.1-1-.5-.1-.4.1-.9.5-1 3.9-1.2 8.7-.6 12 1.4.4.2.5.7.3 1zm.1-2.8C15.1 8.7 9 8.5 5.5 9.6c-.5.2-1.1-.1-1.2-.6-.2-.5.1-1.1.6-1.2 4-1.2 10.7-1 14.9 1.5.5.3.6.9.3 1.4-.3.4-.9.6-1.4.3z"
      />
    </svg>
    <div>
      <p class="spotify-placeholder-title">Spotify player goes here</p>
      <p class="spotify-placeholder-desc">
        Drop in your Spotify show's embed link (Share → Embed episode) and it'll show up as a
        player right in this spot.
      </p>
    </div>
  </div>
)}

<style>
  .spotify-embed {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .spotify-embed iframe {
    display: block;
  }
  .spotify-placeholder {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: var(--color-bg-alt);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem;
  }
  .spotify-mark {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .spotify-placeholder-title {
    margin: 0 0 0.3rem;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .spotify-placeholder-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
